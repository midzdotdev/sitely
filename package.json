{
	"name": "sitely",
	"private": true,
	"scripts": {
		"docs:dev": "vitepress dev docs --port 5273",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs --port 5273",
		"check:links": "lychee --offline --include-fragments --root-dir \"$PWD/docs/.vitepress/dist\" docs/.vitepress/dist",
		"check": "pnpm docs:build && pnpm check:links",
		"typecheck": "pnpm -r typecheck",
		"test": "vitest run --typecheck",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@braintree/sanitize-url": "^7.1.2",
		"@eslint/js": "10.0.1",
		"@types/node": "25.9.3",
		"cytoscape": "^3.33.4",
		"cytoscape-cose-bilkent": "^4.1.0",
		"dayjs": "^1.11.21",
		"debug": "^4.4.3",
		"eslint": "10.5.0",
		"eslint-config-prettier": "10.1.8",
		"fast-check": "4.8.0",
		"globals": "17.6.0",
		"mermaid": "^11.14.0",
		"panzoom": "^9.4.4",
		"prettier": "3.8.4",
		"typescript": "6.0.3",
		"typescript-eslint": "8.61.0",
		"vite": "8.0.16",
		"vitepress": "^1.6.4",
		"vitepress-plugin-mermaid": "^2.0.17",
		"vitest": "4.1.8"
	},
	"packageManager": "pnpm@9.15.4",
	"engines": {
		"node": ">=22"
	}
}
