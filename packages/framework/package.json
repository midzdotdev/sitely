{
	"name": "@sitely/framework",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"bin": {
		"sitely": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"default": "./dist/testing.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@sitely/page": "workspace:*",
		"@sitely/schemas": "workspace:*",
		"ajv": "^8.17.1",
		"fast-json-stable-stringify": "^2.1.0",
		"robots-parser": "^3.0.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/node": "^25.2.2",
		"typescript": "^5.7.3",
		"vitest": "^3.0.4"
	}
}
