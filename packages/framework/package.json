{
	"name": "@wapi/framework",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"bin": {
		"wapi": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"default": "./dist/testing.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@wapi/page": "workspace:*",
		"@wapi/schemas": "workspace:*",
		"robots-parser": "^3.0.1"
	},
	"devDependencies": {
		"@types/node": "^25.2.2",
		"typescript": "^5.7.3",
		"vitest": "^3.0.4"
	}
}
