{
	"name": "@wapi/server",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.js",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate"
	},
	"dependencies": {
		"@hono/node-server": "^1.13.7",
		"@wapi/framework": "workspace:*",
		"@wapi/page": "workspace:*",
		"@wapi/schemas": "workspace:*",
		"drizzle-orm": "^0.38.3",
		"hono": "^4.6.16",
		"ioredis": "^5.4.2",
		"pino": "^9.6.0",
		"postgres": "^3.4.5",
		"robots-parser": "^3.0.1"
	},
	"devDependencies": {
		"@types/node": "^25.2.2",
		"drizzle-kit": "^0.30.2",
		"tsx": "^4.19.2",
		"typescript": "^5.7.3",
		"vitest": "^3.0.4"
	}
}
