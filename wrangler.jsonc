{
	// Cloudflare Workers config for the sitely docs site.
	// The static build produced by `pnpm docs:build` is uploaded as
	// the Worker's static assets — no Worker code needed.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sitely-docs",
	"compatibility_date": "2026-05-28",
	"assets": {
		"directory": "./docs/.vitepress/dist",
		"not_found_handling": "404-page",
	},
}
